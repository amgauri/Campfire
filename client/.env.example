# Copy to .env.local for personal overrides. NEVER put secrets in EXPO_PUBLIC_* vars.
EXPO_PUBLIC_APP_ENV=development            # development | staging | production
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Android emulator: http://10.0.2.2:3000 | physical device: http://<LAN-IP>:3000
EXPO_PUBLIC_USE_MOCKS=true                 # ignored (forced false) in production
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=10000